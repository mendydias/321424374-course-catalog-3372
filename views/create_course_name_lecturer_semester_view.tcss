#form-card {
    width: 60;
    padding: 2 4;
    background: #1c1f28;
    border: round #363c4c;
    border-title-color: #e6e6ea;
}

#course-code,
#department {
    margin: 0 0 1 0;
    text-style: bold;
    color: #b9bfcc;
}

Input {
    margin: 0 0;
}

#buttons {
    height: auto;
}

#buttons Button {
    width: 1fr;
}

#back {
    margin-right: 1;
}
