Screen {
    background: #14161c;
    color: #e6e6ea;
    align: center middle;
}

/* --- Header ----------------------------------------------------------- */

Header {
    background: #0e0f13;
    color: #e6e6ea;
}

/* --- Footer ----------------------------------------------------------- */

Footer {
    background: #0e0f13;
    color: #e6e6ea;
}

Footer > .footer--key {
    color: #5b8cff;
}

/* --- Buttons ---------------------------------------------------------- */

Button {
    margin: 1 0 0 0;
    width: 100%;
    text-style: bold;
    background: #343a4a;
    color: #e6e6ea;
    border: none;
}

Button:hover {
    background: #444b5e;
}

Button:focus {
    text-style: bold underline;
}

Button.-primary {
    background: #5b8cff;
    color: #0e0f13;
}

Button.-primary:hover {
    background: #7aa2ff;
}

/* --- Inputs ----------------------------------------------------------- */

Input {
    background: #22252f;
    color: #e6e6ea;
    border: tall #363c4c;
    padding: 0 1;
}

Input:focus {
    border: tall #5b8cff;
    background: #262a35;
}

Input.-invalid {
    border: tall #ff5c5c;
}

/* --- Errors ----------------------------------------------------------- */

#error {
    margin: 1 0 0 0;
    color: #ff5c5c;
    text-style: bold;
    height: auto;
    min-height: 1;
    content-align: center middle;
    text-wrap: wrap;
    width: 100%;
    display: none;
}

#error.-visible {
    display: block;
}

/* --- DataTable baseline ----------------------------------------------- */

DataTable {
    background: #1c1f28;
    color: #e6e6ea;
}

DataTable > .datatable--header {
    background: #0e0f13;
    color: #e6e6ea;
    text-style: bold;
}

DataTable > .datatable--odd-row {
    background: #22252f;
}

DataTable > .datatable--even-row {
    background: #1c1f28;
}

DataTable > .datatable--hover {
    background: #343a4a;
    color: #e6e6ea;
}

DataTable > .datatable--cursor {
    background: #5b8cff;
    color: #0e0f13;
    text-style: bold;
}
