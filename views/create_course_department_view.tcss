#form-card {
    width: 60;
    padding: 2 4;
    background: #1c1f28;
    border: round #363c4c;
    border-title-color: #e6e6ea;
}

Input {
    margin: 1 0;
}

#buttons {
    height: auto;
}

#buttons Button {
    width: 1fr;
    margin-top: 1;
    margin-right: 1;
    margin-left: 1;
}

#back {
    margin-right: 1;
}
